              Todas
            </button>
            <button class="px-3 py-1.5 rounded-full font-label-md text-label-md bg-surface-container-highest text-on-surface-variant hover:text-on-surface flex items-center gap-1.5 transition-all active:scale-95" id="filter-pendentes" onclick="setActiveFilter('pendentes')" type="button">
              <span>Pendentes</span>

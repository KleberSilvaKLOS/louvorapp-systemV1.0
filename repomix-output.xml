<file path="backend/controllers/swapController.js">
const SwapModel = require('../models/SwapModel');
const ScheduleModel = require('../models/ScheduleModel');
const UserModel = require('../models/UserModel');
const SettingsModel = require('../models/SettingsModel');
const AuditService = require('../services/auditService');
const { requirePermission } = require('../middlewares/permissionMiddleware');
const { sendJson } = require('../middlewares/errorMiddleware');

const SwapController = {
  async list(req, res) {
    await requirePermission(req, 'swaps', 'view');
    const statusFilter = req.query.status || '';
    const [swaps, kpis, settings, candidates] = await Promise.all([
      SwapModel.getAll({ status: statusFilter }),
      SwapModel.getKpiMetrics(),
      SettingsModel.getAllSettings(),
      UserModel.getAll({ status: 'active' })
    ]);

    sendJson(res, 200, {
      ok: true,
      swaps,
      kpis,
      guidelines: {
        swap_deadline_hours: settings.swap_deadline_hours || '24',
        swap_deadline_active: settings.swap_deadline_active !== 'false',
        rehearsal_auto_approve: settings.rehearsal_auto_approve !== 'false'
      },
      candidates: candidates.map((c) => ({
        id: c.id,
        full_name: c.full_name,
        title: c.title,
        whatsapp: c.whatsapp
      }))
    });
  },

  async create(req, res) {
    await requirePermission(req, 'swaps', 'create');
    const { schedule_id, substitute_id, role_label, instrument_detail, song_key_badge, reason } = req.body;
    if (!schedule_id || !reason || String(reason).trim().length < 3) {
      const err = new Error('Informe a escala e o motivo da solicitação de troca.');
      err.status = 400;
      throw err;
    }

    const schedule = await ScheduleModel.getById(parseInt(schedule_id, 10));
    if (!schedule) {
      const err = new Error('Escala informada não existe.');
      err.status = 404;
      throw err;
    }

    const settings = await SettingsModel.getAllSettings();
    const deadlineActive = settings.swap_deadline_active !== 'false';
    const deadlineHours = parseInt(settings.swap_deadline_hours || '24', 10);

    if (deadlineActive && deadlineHours > 0 && req.body.bypass_deadline !== true) {
      const eventIso = `${schedule.event_date}T${schedule.event_time || '19:00'}:00`;
      const eventTs = new Date(eventIso).getTime();
      if (!Number.isNaN(eventTs)) {
        const diffHours = (eventTs - Date.now()) / (1000 * 3600);
        // Bloqueia apenas se o evento estiver dentro da janela crítica (ex: entre -2h e +deadlineHours)
        if (diffHours >= -2 && diffHours < deadlineHours) {
          const err = new Error(
            `Prazo limite encerrado: solicitações de troca devem ser feitas com no mínimo ${deadlineHours}h de antecedência.`
          );
          err.status = 400;
          throw err;
        }
      }
    }

    let created = await SwapModel.createSwapRequest({
      schedule_id: parseInt(schedule_id, 10),
      requester_id: req.user.id,
      substitute_id: substitute_id ? parseInt(substitute_id, 10) : null,
      role_label: role_label || req.user.title || 'Instrumento',
      instrument_detail: instrument_detail || 'Equipe de Louvor',
      song_key_badge: song_key_badge || '',
      reason: String(reason).trim()
    });

    // Verifica diretriz de Autoaprovação de Ensaios (por event_type === 'ensaio' ou título contendo 'ensaio')
    const autoApproveRehearsal = settings.rehearsal_auto_approve !== 'false';
    const isRehearsalEvent =
      schedule.event_type === 'ensaio' || String(schedule.title || '').toLowerCase().includes('ensaio');
    let wasAutoApproved = false;
    if (autoApproveRehearsal && isRehearsalEvent && substitute_id) {
      created = await SwapModel.resolveSwap(
        created.id,
        {
          action: 'approve',
          admin_note: 'Autoaprovada (Diretriz de Ensaio)',
          substitute_id: parseInt(substitute_id, 10)
        },
        req.user.id
      );
      wasAutoApproved = true;
    }

    // Notifica todos os administradores reais (e nunca user_id: 1 fixo)
    await UserModel.notifyAllAdmins({
      title: wasAutoApproved ? 'Troca de Ensaio Autoaprovada' : 'Nova Solicitação de Troca',
      message: `${req.user.full_name} solicitou troca para ${schedule.title}: "${reason}"`,
      type: 'swap'
    });

    await AuditService.record(
      req,
      wasAutoApproved ? 'AUTO_APPROVE_REHEARSAL_SWAP' : 'CREATE_SWAP_REQUEST',
      'swap_request',
      created.id,
      `Solicitou troca na escala #${schedule_id}: ${reason}`
    );

    sendJson(res, 201, {
      ok: true,
      message: wasAutoApproved
        ? 'Troca de ensaio aprovada automaticamente conforme diretriz do ministério!'
        : 'Solicitação de troca publicada e enviada para os substitutos!',
      swap: created
    });
  },

  async confirmWithLeader(req, res) {
    await requirePermission(req, 'swaps', 'edit');
    const swap = await SwapModel.getById(req.params.id);
    if (!swap) {
      const err = new Error('Solicitação de troca não encontrada.');
      err.status = 404;
      throw err;
    }
    if (req.user.role !== 'ADMIN' && swap.requester_id !== req.user.id && swap.substitute_id !== req.user.id) {
      const err = new Error('Você não tem permissão para alterar esta solicitação de troca.');
      err.status = 403;
      throw err;
    }

    const updated = await SwapModel.confirmWithLeader(req.params.id);
    await AuditService.record(
      req,
      'CONFIRM_SWAP_LEADER',
      'swap_request',
      updated.id,
      'Encaminhou troca para homologação final do líder'
    );
    sendJson(res, 200, {
      ok: true,
      message: 'Troca encaminhada para homologação final do líder!',
      swap: updated
    });
  },

  async cancel(req, res) {
    await requirePermission(req, 'swaps', 'edit');
    const swap = await SwapModel.getById(req.params.id);
    if (!swap) {
      const err = new Error('Solicitação de troca não encontrada.');
      err.status = 404;
      throw err;
    }
    if (req.user.role !== 'ADMIN' && swap.requester_id !== req.user.id) {
      const err = new Error('Apenas o solicitante ou um administrador pode cancelar este pedido.');
      err.status = 403;
      throw err;
    }

    const cancelled = await SwapModel.cancelSwap(req.params.id);
    await AuditService.record(
      req,
      'CANCEL_SWAP_REQUEST',
      'swap_request',
      cancelled.id,
      'Cancelou pedido de troca'
    );
    sendJson(res, 200, {
      ok: true,
      message: 'Pedido de troca cancelado com sucesso.',
      swap: cancelled
    });
  },

  async resolve(req, res) {
    await requirePermission(req, 'swaps', 'approve');
    const { action, admin_note, substitute_id } = req.body;
    const validActions = ['approve', 'approve_with_note', 'reject', 'dispense', 'manual_assign'];
    if (!validActions.includes(action)) {
      const err = new Error('Ação de resolução inválida.');
      err.status = 400;
      throw err;
    }

    const resolved = await SwapModel.resolveSwap(
      req.params.id,
      { action, admin_note, substitute_id: substitute_id ? parseInt(substitute_id, 10) : null },
      req.user.id
    );
    if (!resolved) {
      const err = new Error('Solicitação de troca não encontrada.');
      err.status = 404;
      throw err;
    }

    await UserModel.createNotification({
      user_id: resolved.requester_id,
      title: action.startsWith('approve') || action === 'manual_assign'
        ? 'Sua troca foi aprovada!'
        : action === 'dispense'
          ? 'Posto dispensado na escala'
          : 'Solicitação de troca recusada',
      message: `O líder avaliou sua solicitação para ${resolved.schedule ? resolved.schedule.title : 'o culto'}: ${resolved.admin_note || ''}`,
      type: 'swap'
    });

    await AuditService.record(
      req,
      `RESOLVE_SWAP_${action.toUpperCase()}`,
      'swap_request',
      resolved.id,
      `Resolveu troca #${resolved.id} com ação '${action}'`
    );

    sendJson(res, 200, {
      ok: true,
      message:
        action === 'approve'
          ? 'Troca aprovada com sucesso!'
          : action === 'approve_with_note'
            ? 'Troca aprovada com ressalva!'
            : action === 'dispense'
              ? 'Posto dispensado na escala!'
              : action === 'manual_assign'
                ? 'Substituto escalado manualmente com sucesso!'
                : 'Troca recusada.',
      swap: resolved
    });
  },

  async dispatchAlert(req, res) {
    await requirePermission(req, 'swaps', 'approve');
    const updated = await SwapModel.dispatchEmergencyAlert(req.params.id);
    if (!updated) {
      const err = new Error('Solicitação de troca não encontrada.');
      err.status = 404;
      throw err;
    }
    await AuditService.record(
      req,
      'DISPATCH_SWAP_ALERT',
      'swap_request',
      updated.id,
      `Disparou alerta de emergência para ${updated.notified_count || 0} músico(s) (${updated.role_label})`
    );
    sendJson(res, 200, {
      ok: true,
      message: `Alerta enviado para ${updated.notified_count || 0} músico(s) da equipe!`,
      swap: updated
    });
  },

  async batchSmartApprove(req, res) {
    await requirePermission(req, 'swaps', 'approve');
    const allPending = await SwapModel.getAll({ status: 'pending' });
    const readySwaps = allPending.filter((s) => s.substitute_id && s.urgency_type !== 'conflict');
    const approvedIds = [];
    for (const s of readySwaps) {
      await SwapModel.resolveSwap(s.id, { action: 'approve', admin_note: 'Aprovação Inteligente' }, req.user.id);
      approvedIds.push(s.id);
    }
    await AuditService.record(
      req,
      'BATCH_SMART_APPROVE',
      'swap_request',
      approvedIds.join(',') || 'none',
      `Aprovou automaticamente ${approvedIds.length} troca(s) com par ideal`
    );
    sendJson(res, 200, {
      ok: true,
      approvedCount: approvedIds.length,
      approvedIds,
      message:
        approvedIds.length > 0
          ? `${approvedIds.length} troca(s) com par ideal aprovada(s) com sucesso!`
          : 'Nenhuma troca pendente com par ideal sem conflito na fila.'
    });
  }
};

module.exports = SwapController;
</file>

<file path="backend/controllers/userController.js">
const db = require('../config/database');
const UserModel = require('../models/UserModel');
const PermissionModel = require('../models/PermissionModel');
const SettingsModel = require('../models/SettingsModel');
const AuthService = require('../services/authService');
const AuditService = require('../services/auditService');
const { requirePermission } = require('../middlewares/permissionMiddleware');
const { sendJson } = require('../middlewares/errorMiddleware');

const UserController = {
  async getMyProfile(req, res) {
    await requirePermission(req, 'profile', 'view');
    await UserModel.recalculateUserStats(req.user.id);
    const [user, notifications, settings, swapsCountRow] = await Promise.all([
      UserModel.findById(req.user.id),
      UserModel.getNotifications(req.user.id),
      SettingsModel.getAllSettings(),
      db.get('SELECT COUNT(*) as count FROM swap_requests WHERE requester_id = ?', [req.user.id])
    ]);
    const permissions = await PermissionModel.getPermissionsByRole(user.role);
    sendJson(res, 200, {
      ok: true,
      user: {
        ...UserModel.sanitize(user),
        swaps_requested_count: (swapsCountRow && swapsCountRow.count) || 0,
        permissions
      },
      notifications,
      settings
    });
  },

  async updateMyProfile(req, res) {
    await requirePermission(req, 'profile', 'edit');

    if (req.body.role !== undefined && req.body.role !== req.user.role) {
      const err = new Error('Operação bloqueada: usuários não podem alterar o próprio nível de acesso.');
      err.status = 403;
      throw err;
    }

    const updated = await UserModel.updateProfile(req.user.id, req.body);
    AuthService.invalidateSessionCache(null, req.user.id);
    const permissions = await PermissionModel.getPermissionsByRole(updated.role);
    const swapsCountRow = await db.get('SELECT COUNT(*) as count FROM swap_requests WHERE requester_id = ?', [req.user.id]);
    sendJson(res, 200, {
      ok: true,
      message: 'Preferência atualizada com sucesso!',
      user: {
        ...UserModel.sanitize(updated),
        swaps_requested_count: (swapsCountRow && swapsCountRow.count) || 0,
        permissions
      }
    });
  },

  async addMySkill(req, res) {
    await requirePermission(req, 'profile', 'edit');
    if (!req.body.skill_name) {
      const err = new Error('Informe o nome da função ou instrumento.');
      err.status = 400;
      throw err;
    }
    const skill = await UserModel.addSkill(req.user.id, req.body);
    AuthService.invalidateSessionCache(null, req.user.id);
    const skills = await UserModel.getUserSkills(req.user.id);
    sendJson(res, 201, {
      ok: true,
      message: 'Habilidade adicionada com sucesso!',
      skill,
      skills
    });
  },

  async updateMySkill(req, res) {
    await requirePermission(req, 'profile', 'edit');
    const updated = await UserModel.updateSkill(req.params.skillId, req.user.id, req.body);
    if (!updated) {
      const err = new Error('Habilidade não encontrada.');
      err.status = 404;
      throw err;
    }
    AuthService.invalidateSessionCache(null, req.user.id);
    const skills = await UserModel.getUserSkills(req.user.id);
    sendJson(res, 200, {
      ok: true,
      message: 'Habilidade atualizada!',
      skill: updated,
      skills
    });
  },

  async deleteMySkill(req, res) {
    await requirePermission(req, 'profile', 'edit');
    await UserModel.deleteSkill(req.params.skillId, req.user.id);
    AuthService.invalidateSessionCache(null, req.user.id);
    const skills = await UserModel.getUserSkills(req.user.id);
    sendJson(res, 200, {
      ok: true,
      message: 'Habilidade removida!',
      skills
    });
  },

  async listNotifications(req, res) {
    const notifications = await UserModel.getNotifications(req.user.id);
    sendJson(res, 200, { ok: true, notifications });
  },

  async markNotificationsRead(req, res) {
    await UserModel.markNotificationsRead(req.user.id);
    const notifications = await UserModel.getNotifications(req.user.id);
    sendJson(res, 200, { ok: true, message: 'Notificações marcadas como lidas.', notifications });
  },

  async listAllUsers(req, res) {
    await requirePermission(req, 'users', 'view');
    const users = await UserModel.getAll({
      search: req.query.search || '',
      role: req.query.role || '',
      status: req.query.status || ''
    });
    sendJson(res, 200, { ok: true, users });
  },

  async adminCreateUser(req, res) {
    await requirePermission(req, 'users', 'create');
    const { full_name, email, whatsapp, password, role = 'USER', title, campus, roles = ['vocal'] } = req.body;
    if (!full_name || !email || !whatsapp || !password) {
      const err = new Error('Preencha nome, e-mail, WhatsApp e senha.');
      err.status = 400;
      throw err;
    }
    const existing = await UserModel.findByEmail(email);
    if (existing) {
      const err = new Error('Já existe um usuário com este e-mail.');
      err.status = 409;
      throw err;
    }
    const passwordHash = await AuthService.hashPasswordAsync(password);
    const created = await UserModel.createUser({
      full_name,
      email,
      whatsapp,
      password_hash: passwordHash,
      role: role === 'ADMIN' ? 'ADMIN' : 'USER',
      title: title || 'Membro do Ministério',
      campus: campus || 'Campus Central',
      team_badge: role === 'ADMIN' ? 'Líder • Admin' : 'Novo Membro'
    });
    await UserModel.setUserSkills(created.id, Array.isArray(roles) ? roles : ['vocal']);
    await AuditService.record(
      req,
      'ADMIN_CREATE_USER',
      'user',
      created.id,
      `Criou usuário ${created.email} com perfil ${created.role}`
    );
    sendJson(res, 201, {
      ok: true,
      message: 'Usuário cadastrado com sucesso!',
      user: UserModel.sanitize(await UserModel.findById(created.id))
    });
  },

  async adminUpdateUser(req, res) {
    await requirePermission(req, 'users', 'edit');
    const targetId = parseInt(req.params.id, 10);

    if (targetId === req.user.id && req.body.role && req.body.role !== req.user.role) {
      const err = new Error('Você não pode alterar seu próprio nível de acesso.');
      err.status = 403;
      throw err;
    }

    const updated = await UserModel.updateRoleOrStatusByAdmin(targetId, req.body);
    if (!updated) {
      const err = new Error('Usuário não encontrado.');
      err.status = 404;
      throw err;
    }
    AuthService.invalidateSessionCache(null, targetId);

    await AuditService.record(
      req,
      'ADMIN_UPDATE_USER',
      'user',
      updated.id,
      `Atualizou usuário ${updated.email} (role=${updated.role}, status=${updated.status})`
    );
    sendJson(res, 200, {
      ok: true,
      message: 'Dados e permissões do usuário atualizados!',
      user: UserModel.sanitize(updated)
    });
  },

  async adminDeleteUser(req, res) {
    await requirePermission(req, 'users', 'delete');
    const targetId = parseInt(req.params.id, 10);
    if (targetId === req.user.id) {
      const err = new Error('Você não pode excluir sua própria conta ativa.');
      err.status = 400;
      throw err;
    }
    const existing = await UserModel.findById(targetId);
    if (!existing) {
      const err = new Error('Usuário não encontrado.');
      err.status = 404;
      throw err;
    }
    await UserModel.deleteUser(targetId);
    AuthService.invalidateSessionCache(null, targetId);
    await AuditService.record(
      req,
      'ADMIN_DELETE_USER',
      'user',
      targetId,
      `Excluiu usuário ${existing.email}`
    );
    sendJson(res, 200, {
      ok: true,
      message: 'Usuário removido do sistema.'
    });
  }
};

module.exports = UserController;
</file>

<file path="backend/middlewares/authMiddleware.js">
const AuthService = require('../services/authService');

function parseCookies(cookieHeader = '') {
  const cookies = {};
  if (!cookieHeader) return cookies;
  for (const pair of cookieHeader.split(';')) {
    const idx = pair.indexOf('=');
    if (idx === -1) continue;
    const k = pair.slice(0, idx).trim();
    const v = decodeURIComponent(pair.slice(idx + 1).trim());
    cookies[k] = v;
  }
  return cookies;
}

function extractToken(req) {
  const authHeader = req.headers['authorization'] || '';
  if (authHeader.startsWith('Bearer ')) {
    return authHeader.slice(7).trim();
  }
  const cookies = parseCookies(req.headers['cookie']);
  if (cookies.louvorapp_token) {
    return cookies.louvorapp_token;
  }
  return null;
}

/**
 * Middleware de autenticação obrigatória no backend.
 * Valida o token de sessão no banco de dados e injeta req.user e req.token.
 */
async function requireAuth(req, res) {
  const token = extractToken(req);
  if (!token) {
    const err = new Error('Não autenticado. Faça login para acessar este recurso.');
    err.status = 401;
    throw err;
  }

  const user = await AuthService.getSessionUser(token);
  if (!user) {
    const err = new Error('Sessão inválida ou expirada. Faça login novamente.');
    err.status = 401;
    throw err;
  }

  req.user = user;
  req.token = token;
  return user;
}

module.exports = {
  extractToken,
  parseCookies,
  requireAuth
};

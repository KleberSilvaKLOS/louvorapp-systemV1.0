<file path="backend/models/SwapModel.js">
const db = require('../config/database');
const UserModel = require('./UserModel');

const SwapModel = {
  async batchEnrichSwaps(swaps) {
    if (!swaps || swaps.length === 0) return [];
    const schedIds = Array.from(new Set(swaps.map((s) => s.schedule_id).filter(Boolean)));
    const userIds = Array.from(
      new Set(
        swaps
          .flatMap((s) => [s.requester_id, s.substitute_id])
          .filter(Boolean)
      )
    );

    const [schedules, users] = await Promise.all([
      schedIds.length > 0
        ? db.all(`SELECT * FROM schedules WHERE id IN (${schedIds.map(() => '?').join(',')})`, schedIds)
        : [],
      userIds.length > 0
        ? db.all(
            `SELECT id, full_name, email, whatsapp, avatar_url, title, team_badge FROM users WHERE id IN (${userIds.map(() => '?').join(',')})`,
            userIds
          )
        : []
    ]);

    const schedMap = new Map(schedules.map((s) => [s.id, s]));
    const userMap = new Map(users.map((u) => [u.id, u]));

    return swaps.map((sw) => ({
      ...sw,
      schedule: schedMap.get(sw.schedule_id) || null,
      requester: userMap.get(sw.requester_id) || null,
      substitute: sw.substitute_id ? userMap.get(sw.substitute_id) || null : null
    }));
  },

  async getAll({ status = '', requester_id = null } = {}) {
    let sql = 'SELECT * FROM swap_requests WHERE 1=1';
    const params = [];
    if (status) {
      if (status === 'approved') {
        sql += " AND status IN ('approved', 'approved_with_note', 'slot_dispensed')";
      } else if (status === 'rejected') {
        sql += " AND status IN ('rejected', 'cancelled')";
      } else {
        sql += ' AND status = ?';
        params.push(status);
      }
    }
    if (requester_id) {
      sql += ' AND (requester_id = ? OR substitute_id = ?)';
      params.push(requester_id, requester_id);
    }
    sql += ' ORDER BY CASE WHEN status = "pending" THEN 0 ELSE 1 END, id DESC';
    const rows = await db.all(sql, params);
    return this.batchEnrichSwaps(rows);
  },

  async getById(id) {
    const row = await db.get('SELECT * FROM swap_requests WHERE id = ?', [id]);
    if (!row) return null;
    const [enriched] = await this.batchEnrichSwaps([row]);
    return enriched;
  },

  async getKpiMetrics() {
    const [pendingRow, approvedRow, rejectedRow, smartReadyRow, avgTimeRow, memberStats] = await Promise.all([
      db.get("SELECT COUNT(*) as count FROM swap_requests WHERE status = 'pending'"),
      db.get("SELECT COUNT(*) as count FROM swap_requests WHERE status IN ('approved', 'approved_with_note', 'slot_dispensed')"),
      db.get("SELECT COUNT(*) as count FROM swap_requests WHERE status IN ('rejected', 'cancelled')"),
      db.get("SELECT COUNT(*) as count FROM swap_requests WHERE status = 'pending' AND substitute_id IS NOT NULL AND urgency_type != 'conflict'"),
      db.get(
        `SELECT AVG(MAX(0, (julianday(resolved_at) - julianday(created_at)) * 24.0)) as avg_hours
         FROM swap_requests
         WHERE resolved_at IS NOT NULL AND created_at IS NOT NULL`
      ),
      db.get(
        `SELECT COUNT(*) as total_slots,
                SUM(CASE WHEN confirmation_status = 'confirmed' THEN 1 ELSE 0 END) as confirmed_slots
         FROM schedule_members`
      )
    ]);

    const pendingCount = (pendingRow && pendingRow.count) || 0;
    const approvedCount = (approvedRow && approvedRow.count) || 0;
    const rejectedCount = (rejectedRow && rejectedRow.count) || 0;
    const totalSlots = (memberStats && memberStats.total_slots) || 0;
    const confirmedSlots = (memberStats && memberStats.confirmed_slots) || 0;

    let avgResponseTime = '0h';
    if (avgTimeRow && avgTimeRow.avg_hours !== null && avgTimeRow.avg_hours !== undefined) {
      const h = Number(avgTimeRow.avg_hours);
      avgResponseTime = h < 0.1 ? '0.1h' : `${h.toFixed(1)}h`;
    }

    const coveragePercent = totalSlots > 0 ? `${Math.round((confirmedSlots / totalSlots) * 100)}%` : '0%';

    return {
      pendingCount,
      approvedCount,
      rejectedCount,
      avgResponseTime,
      coveragePercent,
      smartReadyCount: (smartReadyRow && smartReadyRow.count) || 0
    };
  },

  async createSwapRequest({
    schedule_id,
    requester_id,
    substitute_id = null,
    role_label = 'Instrumento',
    instrument_detail = 'Equipe de Louvor',
    song_key_badge = '',
    reason
  }) {
    const memberRow = await db.get(
      'SELECT * FROM schedule_members WHERE schedule_id = ? AND user_id = ?',
      [schedule_id, requester_id]
    );

    if (memberRow) {
      await db.run("UPDATE schedule_members SET confirmation_status = 'swap_requested' WHERE id = ?", [memberRow.id]);
    }

    const hasSub = Boolean(substitute_id);
    const urgency_type = hasSub ? 'urgent' : 'open_slot';
    const badge_text = hasSub ? 'Solicitação com Substituto' : 'Sem Substituto • Busca Ativa';
    const insight_type = hasSub ? 'positive' : 'critical';
    const insight_title = hasSub ? 'Substituto indicado:' : 'Vaga em aberto:';
    const insight_text = hasSub
      ? 'Substituto indicado está disponível para assumir a escala.'
      : 'Aguardando voluntários ou escalação manual do líder.';

    const res = await db.run(
      `INSERT INTO swap_requests (
        schedule_id, schedule_member_id, requester_id, substitute_id,
        role_label, instrument_detail, song_key_badge, reason,
        urgency_type, badge_text, insight_type, insight_title, insight_text,
        substitute_badge, substitute_status_text, status
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending')`,
      [
        schedule_id,
        memberRow ? memberRow.id : null,
        requester_id,
        substitute_id,
        role_label,
        instrument_detail,
        song_key_badge,
        reason,
        urgency_type,
        badge_text,
        insight_type,
        insight_title,
        insight_text,
        hasSub ? 'Disponível & Apto' : 'Em aberto',
        hasSub ? 'Aceitou substituir' : '0 voluntários responderam'
      ]
    );
    return this.getById(res.lastID);
  },

  async confirmWithLeader(id) {
    await db.run(
      'UPDATE swap_requests SET member_confirmed_leader = 1 WHERE id = ?',
      [id]
    );
    return this.getById(id);
  },

  async cancelSwap(id) {
    const swap = await this.getById(id);
    if (!swap) return null;
    await db.run(
      "UPDATE swap_requests SET status = 'cancelled', resolved_at = datetime('now') WHERE id = ?",
      [id]
    );
    if (swap.schedule_member_id) {
      await db.run(
        "UPDATE schedule_members SET confirmation_status = 'confirmed' WHERE id = ?",
        [swap.schedule_member_id]
      );
    }
    return this.getById(id);
  },

  async resolveSwap(id, { action, admin_note = '', substitute_id = null }, adminUserId) {
    const swap = await this.getById(id);
    if (!swap) return null;

    const finalSubId = substitute_id || swap.substitute_id;
    let newStatus = 'approved';
    let noteText = admin_note || 'Aprovado';

    if (action === 'reject') {
      newStatus = 'rejected';
      noteText = admin_note || 'Recusado';
    } else if (action === 'approve_with_note') {
      newStatus = 'approved_with_note';
      noteText = admin_note || 'Aprovado c/ Ressalva';
    } else if (action === 'dispense') {
      newStatus = 'slot_dispensed';
      noteText = admin_note || 'Posto dispensado pelo líder';
    } else if (action === 'manual_assign' && finalSubId) {
      newStatus = 'approved';
      noteText = admin_note || 'Escalado manualmente pelo líder';
    }

    const stmts = [
      {
        sql: `UPDATE swap_requests
              SET status = ?, substitute_id = COALESCE(?, substitute_id), admin_note = ?, resolved_by = ?, resolved_at = datetime('now')
              WHERE id = ?`,
        params: [newStatus, finalSubId, noteText, adminUserId, id]
      }
    ];

    if ((newStatus === 'approved' || newStatus === 'approved_with_note') && finalSubId) {
      const subUser = await db.get('SELECT * FROM users WHERE id = ?', [finalSubId]);
      if (subUser) {
        // Remove o titular antigo e insere/atualiza o substituto sem violar UNIQUE(schedule_id, user_id)
        stmts.push({
          sql: 'DELETE FROM schedule_members WHERE schedule_id = ? AND user_id = ?',
          params: [swap.schedule_id, swap.requester_id]
        });
        stmts.push({
          sql: `INSERT INTO schedule_members (schedule_id, user_id, role_key, role_label, instrument_detail, is_leader, confirmation_status, icon, color_variant)
                VALUES (?, ?, 'teclado', ?, ?, 0, 'confirmed', 'music_note', 'secondary')
                ON CONFLICT(schedule_id, user_id) DO UPDATE SET
                  role_label = excluded.role_label,
                  instrument_detail = excluded.instrument_detail,
                  confirmation_status = 'confirmed',
                  updated_at = datetime('now')`,
          params: [swap.schedule_id, subUser.id, subUser.full_name, swap.role_label || subUser.title]
        });
      }
    } else if (newStatus === 'slot_dispensed') {
      stmts.push({
        sql: 'DELETE FROM schedule_members WHERE schedule_id = ? AND user_id = ?',
        params: [swap.schedule_id, swap.requester_id]
      });
    } else if (newStatus === 'rejected') {
      stmts.push({
        sql: "UPDATE schedule_members SET confirmation_status = 'confirmed' WHERE schedule_id = ? AND user_id = ?",
        params: [swap.schedule_id, swap.requester_id]
      });
    }

    await db.transaction(stmts);
    await UserModel.recalculateUserStats(swap.requester_id);
    if (finalSubId) await UserModel.recalculateUserStats(finalSubId);

    return this.getById(id);
  },

  async dispatchEmergencyAlert(id) {
    const swap = await this.getById(id);
    if (!swap) return null;

    // Busca músicos ativos que podem substituir (exceto o próprio solicitante)
    const candidates = await db.all(
      `SELECT DISTINCT u.id, u.full_name
       FROM users u
       LEFT JOIN user_skills us ON us.user_id = u.id
       WHERE u.status = 'active' AND u.id != ?
         AND (LOWER(us.skill_name) LIKE LOWER(?) OR LOWER(u.title) LIKE LOWER(?) OR 1=1)
       LIMIT 10`,
      [swap.requester_id, `%${swap.role_label}%`, `%${swap.role_label}%`]
    );

    const notifiedCount = candidates.length;
    const stmts = candidates.map((c) => ({
      sql: 'INSERT INTO notifications (user_id, title, message, type, is_read) VALUES (?, ?, ?, ?, 0)',
      params: [
        c.id,
        `Chamado de Substituição: ${swap.role_label}`,
        `Vaga em aberto para ${swap.schedule ? swap.schedule.title : 'Escala'} (${swap.schedule ? swap.schedule.event_date : ''}).`,
        'swap'
      ]
    }));

    stmts.push({
      sql: `UPDATE swap_requests
            SET alert_dispatched = 1, substitute_status_text = ?
            WHERE id = ?`,
      params: [`Alerta disparado para ${notifiedCount} músico(s)!`, id]
    });

    await db.transaction(stmts);
    const updated = await this.getById(id);
    updated.notified_count = notifiedCount;
    return updated;
  }
};

module.exports = SwapModel;
</file>

<file path="backend/models/UserModel.js">
const db = require('../config/database');

const MAX_AVATAR_LENGTH = 200 * 1024; // Máximo ~150KB em Base64
const DATA_IMAGE_REGEX = /^data:image\/(jpeg|jpg|png|webp|svg\+xml);base64,[A-Za-z0-9+/=]+$/i;

const UserModel = {
  async findByEmail(email) {
    return db.get('SELECT * FROM users WHERE LOWER(email) = LOWER(?)', [String(email || '').trim()]);
  },

  async findById(id) {
    const user = await db.get('SELECT * FROM users WHERE id = ?', [id]);
    if (!user) return null;
    user.skills = await this.getUserSkills(user.id);
    return user;
  },

  async getAll({ search = '', role = '', status = '' } = {}) {
    let sql =
      'SELECT id, full_name, email, whatsapp, role, status, avatar_url, team_badge, schedule_badge, title, campus, favorite_services, favorite_frequency_badge, desired_frequency, recurring_restriction, notif_convocacoes, notif_ensaios, notif_enquetes, notif_trocas, calendar_sync, completed_schedules_count, attendance_rate, first_access_completed, created_at FROM users WHERE 1=1';
    const params = [];
    if (search) {
      sql += ' AND (LOWER(full_name) LIKE LOWER(?) OR LOWER(email) LIKE LOWER(?) OR LOWER(title) LIKE LOWER(?))';
      params.push(`%${search}%`, `%${search}%`, `%${search}%`);
    }
    if (role) {
      sql += ' AND role = ?';
      params.push(role);
    }
    if (status) {
      sql += ' AND status = ?';
      params.push(status);
    }
    sql += ' ORDER BY role ASC, full_name ASC';

    const users = await db.all(sql, params);
    if (users.length > 0) {
      const userIds = users.map((u) => u.id);
      const placeholders = userIds.map(() => '?').join(',');
      const allSkills = await db.all(
        `SELECT * FROM user_skills WHERE user_id IN (${placeholders}) ORDER BY id ASC`,
        userIds
      );
      const skillsByUser = new Map();
      for (const sk of allSkills) {
        if (!skillsByUser.has(sk.user_id)) skillsByUser.set(sk.user_id, []);
        skillsByUser.get(sk.user_id).push(sk);
      }
      for (const u of users) {
        u.skills = skillsByUser.get(u.id) || [];
      }
    }
    return users;
  },

  async getUserSkills(userId) {
    return db.all('SELECT * FROM user_skills WHERE user_id = ? ORDER BY id ASC', [userId]);
  },

  async createUser({
    full_name,
    email,
    whatsapp,
    password_hash,
    role,
    notif_convocacoes = 1,
    campus = 'Campus Central',
    title = 'Membro do Ministério',
    team_badge = 'Novo Membro'
  }) {
    const res = await db.run(
      `INSERT INTO users (
        full_name, email, whatsapp, password_hash, role, status, avatar_url,
        team_badge, schedule_badge, title, campus,
        favorite_services, favorite_frequency_badge, desired_frequency, recurring_restriction,
        notif_convocacoes, notif_ensaios, notif_enquetes, notif_trocas,
        calendar_sync, completed_schedules_count, attendance_rate, first_access_completed
      ) VALUES (?, ?, ?, ?, ?, 'active', '', ?, 'Sem escala', ?, ?, 'Não definido', '-', 'Não definida', 'Nenhuma restrição cadastrada', ?, ?, ?, ?, 0, 0, 0, 0)`,
      [
        full_name,
        email.trim().toLowerCase(),
        whatsapp,
        password_hash,
        role,
        team_badge,
        title,
        campus,
        notif_convocacoes ? 1 : 0,
        notif_convocacoes ? 1 : 0,
        notif_convocacoes ? 1 : 0,
        notif_convocacoes ? 1 : 0
      ]
    );
    return this.findById(res.lastID);
  },

  async setUserSkills(userId, rolesArray = []) {
    const roleMap = {
      vocal: { name: 'Vocal Solo & Backing', icon: 'mic', color: 'secondary', notes: 'Voz Principal & Harmonia Vocal' },
      violao: { name: 'Violão Acústico', icon: 'queue_music', color: 'tertiary', notes: 'Violão Aço & Base Harmônica' },
      guitarra: { name: 'Guitarra', icon: 'electric_bolt', color: 'primary', notes: 'Guitarra Base & Solo' },
      teclado: { name: 'Teclado & Synth', icon: 'piano', color: 'primary', notes: 'Piano & Worship Pads' },
      baixo: { name: 'Contrabaixo', icon: 'graphic_eq', color: 'secondary', notes: 'Contrabaixo 4/5 Cordas' },
      bateria: { name: 'Bateria Acústica', icon: 'album', color: 'primary', notes: 'Bateria / Metrônomo (In-Ear)' }
    };

    const statements = [{ sql: 'DELETE FROM user_skills WHERE user_id = ?', params: [userId] }];
    let idx = 0;
    for (const rKey of rolesArray) {
      const key = String(rKey).toLowerCase();
      const meta = roleMap[key] || { name: rKey, icon: 'music_note', color: 'primary', notes: 'Instrumento / Apoio' };
      const level = idx === 0 ? 'Principal' : idx === 1 ? 'Secundário' : 'Suporte';
      statements.push({
        sql: `INSERT INTO user_skills (user_id, role_key, skill_name, level_badge, equipment_notes, status, icon, color_variant)
              VALUES (?, ?, ?, ?, ?, 'Ativo', ?, ?)`,
        params: [userId, key, meta.name, level, meta.notes, meta.icon, meta.color]
      });
      idx++;
    }
    await db.transaction(statements);
    return this.getUserSkills(userId);
  },

  async addSkill(userId, { role_key = 'teclado', skill_name, level_badge = 'Principal', equipment_notes = '', status = 'Ativo', icon = 'music_note', color_variant = 'primary' }) {
    const res = await db.run(
      `INSERT INTO user_skills (user_id, role_key, skill_name, level_badge, equipment_notes, status, icon, color_variant)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
      [userId, role_key, skill_name, level_badge, equipment_notes, status, icon, color_variant]
    );
    return db.get('SELECT * FROM user_skills WHERE id = ?', [res.lastID]);
  },

  async updateSkill(skillId, userId, fields) {
    const skill = await db.get('SELECT * FROM user_skills WHERE id = ? AND user_id = ?', [skillId, userId]);
    if (!skill) return null;
    const skill_name = fields.skill_name !== undefined ? fields.skill_name : skill.skill_name;
    const level_badge = fields.level_badge !== undefined ? fields.level_badge : skill.level_badge;
    const equipment_notes = fields.equipment_notes !== undefined ? fields.equipment_notes : skill.equipment_notes;
    const status = fields.status !== undefined ? fields.status : skill.status;
    await db.run(
      `UPDATE user_skills SET skill_name = ?, level_badge = ?, equipment_notes = ?, status = ? WHERE id = ?`,
      [skill_name, level_badge, equipment_notes, status, skillId]
    );
    return db.get('SELECT * FROM user_skills WHERE id = ?', [skillId]);
  },

  async deleteSkill(skillId, userId) {
    return db.run('DELETE FROM user_skills WHERE id = ? AND user_id = ?', [skillId, userId]);
  },

  validateAvatarUrl(avatarUrl) {
    if (avatarUrl === '' || avatarUrl === null) return '';
    const str = String(avatarUrl).trim();
    if (str.length > MAX_AVATAR_LENGTH) {
      const err = new Error('A imagem de perfil excede o tamanho máximo permitido (150KB).');
      err.status = 400;
      throw err;
    }
    if (str.startsWith('/assets/images/')) return str;
    if (!DATA_IMAGE_REGEX.test(str)) {
      const err = new Error('Formato de imagem inválido. Envie uma imagem PNG, JPEG ou WebP válida.');
      err.status = 400;
      throw err;
    }
    return str;
  },

  async updateProfile(userId, data) {
    const current = await db.get('SELECT * FROM users WHERE id = ?', [userId]);
    if (!current) return null;

    if (data.avatar_url !== undefined) {
      data.avatar_url = this.validateAvatarUrl(data.avatar_url);
    }

    const allowed = [
      'full_name', 'whatsapp', 'avatar_url', 'team_badge', 'schedule_badge', 'title', 'campus',
      'favorite_services', 'favorite_frequency_badge', 'desired_frequency', 'recurring_restriction',
      'notif_convocacoes', 'notif_ensaios', 'notif_enquetes', 'notif_trocas', 'calendar_sync',
      'first_access_completed'
    ];

    const sets = [];
    const params = [];
    for (const key of allowed) {
      if (data[key] !== undefined) {
        sets.push(`${key} = ?`);
        if (key.startsWith('notif_') || key === 'calendar_sync' || key === 'first_access_completed') {
          params.push(data[key] ? 1 : 0);
        } else {
          params.push(data[key]);
        }
      }
    }
    if (sets.length > 0) {
      sets.push("updated_at = datetime('now')");
      params.push(userId);
      await db.run(`UPDATE users SET ${sets.join(', ')} WHERE id = ?`, params);
    }
    return this.findById(userId);
  },

  async recalculateUserStats(userId) {
    const rows = await db.all('SELECT confirmation_status FROM schedule_members WHERE user_id = ?', [userId]);
    const total = rows.length;
    const confirmed = rows.filter((r) => r.confirmation_status === 'confirmed').length;
    const rate = total > 0 ? Math.round((confirmed / total) * 100) : 0;
    const scheduleBadge = total > 0 ? 'Escalado' : 'Sem escala';
    await db.run(
      `UPDATE users SET completed_schedules_count = ?, attendance_rate = ?, schedule_badge = ?, updated_at = datetime('now') WHERE id = ?`,
      [confirmed, rate, scheduleBadge, userId]
    );
    return { completed_schedules_count: confirmed, attendance_rate: rate };
  },

  async updateRoleOrStatusByAdmin(targetUserId, { role, status, team_badge, title, campus, full_name, whatsapp }) {
    const current = await db.get('SELECT * FROM users WHERE id = ?', [targetUserId]);
    if (!current) return null;
    await db.run(
      `UPDATE users SET
        role = COALESCE(?, role),
        status = COALESCE(?, status),
        team_badge = COALESCE(?, team_badge),
        title = COALESCE(?, title),
        campus = COALESCE(?, campus),
        full_name = COALESCE(?, full_name),
        whatsapp = COALESCE(?, whatsapp),
        updated_at = datetime('now')
       WHERE id = ?`,
      [
        role || null,
        status || null,
        team_badge || null,
        title || null,
        campus || null,
        full_name || null,
        whatsapp || null,
        targetUserId
      ]
    );
    if (status === 'inactive' || (role && role !== current.role)) {
      await db.run('DELETE FROM sessions WHERE user_id = ?', [targetUserId]);
    }
    return this.findById(targetUserId);
  },

  async deleteUser(targetUserId) {
    await db.run('DELETE FROM sessions WHERE user_id = ?', [targetUserId]);
    return db.run('DELETE FROM users WHERE id = ?', [targetUserId]);
  },

  async getNotifications(userId) {
    return db.all(
      'SELECT * FROM notifications WHERE user_id = ? OR user_id IS NULL ORDER BY created_at DESC, id DESC LIMIT 30',
      [userId]
    );
  },

  async markNotificationsRead(userId) {
    return db.run('UPDATE notifications SET is_read = 1 WHERE user_id = ? OR user_id IS NULL', [userId]);
  },

  async createNotification({ user_id = null, title, message, type = 'info' }) {
    return db.run(
      'INSERT INTO notifications (user_id, title, message, type, is_read) VALUES (?, ?, ?, ?, 0)',
      [user_id, title, message, type]
    );
  },

  async notifyAllAdmins({ title, message, type = 'info' }) {
    const admins = await db.all("SELECT id FROM users WHERE role = 'ADMIN' AND status = 'active'");
    if (admins.length === 0) return;
    const stmts = admins.map((a) => ({
      sql: 'INSERT INTO notifications (user_id, title, message, type, is_read) VALUES (?, ?, ?, ?, 0)',
      params: [a.id, title, message, type]
    }));
    return db.transaction(stmts);
  },

  sanitize(user) {
    if (!user) return null;
    const copy = { ...user };
    delete copy.password_hash;
    delete copy.reset_token;
    delete copy.reset_token_expires;
    return copy;
  }
};

module.exports = UserModel;
</file>

<file path="backend/routes/apiRouter.js">
const AuthController = require('../controllers/authController');
const ScheduleController = require('../controllers/scheduleController');
const SwapController = require('../controllers/swapController');
const PollController = require('../controllers/pollController');
const RepertoireController = require('../controllers/repertoireController');
const UserController = require('../controllers/userController');
const SettingsController = require('../controllers/settingsController');
const { requireAuth } = require('../middlewares/authMiddleware');
const { sendJson } = require('../middlewares/errorMiddleware');

class Router {
  constructor() {
    this.routes = [];
  }

  register(method, pattern, handler, authRequired = true) {
    const paramNames = [];
    const regexPath = pattern.replace(/:([a-zA-Z0-9_]+)/g, (_, paramName) => {
      paramNames.push(paramName);
      return '([^/]+)';
    });
    const regex = new RegExp(`^${regexPath}$`);
    this.routes.push({ method: method.toUpperCase(), regex, paramNames, handler, authRequired });
  }

  async handle(req, res, pathname, query) {
    const method = req.method.toUpperCase();
    for (const r of this.routes) {
      if (r.method !== method) continue;
      const match = pathname.match(r.regex);
      if (!match) continue;

      const params = {};
      r.paramNames.forEach((name, idx) => {
        params[name] = decodeURIComponent(match[idx + 1]);
      });
      req.params = params;
      req.query = query;

      if (r.authRequired) {
        await requireAuth(req, res);
      }
      return r.handler(req, res);
    }

    sendJson(res, 404, { ok: false, error: `Rota de API não encontrada: ${method} ${pathname}` });
  }
}

const apiRouter = new Router();

// Healthcheck
apiRouter.register('GET', '/api/health', async (req, res) => {
  sendJson(res, 200, { ok: true, status: 'healthy', version: '2.4.1', timestamp: new Date().toISOString() });
}, false);

// Public Settings (banner de ensaio e nome do ministério)
apiRouter.register('GET', '/api/settings/public', SettingsController.getPublicInfo, false);

// Auth Routes
apiRouter.register('POST', '/api/auth/register', AuthController.register, false);
apiRouter.register('POST', '/api/auth/login', AuthController.login, false);
apiRouter.register('POST', '/api/auth/forgot-password', AuthController.forgotPassword, false);
apiRouter.register('POST', '/api/auth/reset-password', AuthController.resetPassword, false);
apiRouter.register('POST', '/api/auth/logout', AuthController.logout, true);
apiRouter.register('GET', '/api/auth/me', AuthController.me, true);
apiRouter.register('POST', '/api/auth/change-password', AuthController.changePassword, true);

// Schedules & Calendar Routes
apiRouter.register('GET', '/api/schedules', ScheduleController.list, true);
apiRouter.register('GET', '/api/schedules/my', ScheduleController.mySchedules, true);
apiRouter.register('GET', '/api/schedules/ics', ScheduleController.exportIcs, true);
apiRouter.register('GET', '/api/schedules/:id', ScheduleController.getOne, true);
apiRouter.register('POST', '/api/schedules', ScheduleController.create, true);
apiRouter.register('PUT', '/api/schedules/:id', ScheduleController.update, true);
apiRouter.register('DELETE', '/api/schedules/:id', ScheduleController.remove, true);
apiRouter.register('POST', '/api/schedules/:id/members', ScheduleController.addMember, true);
apiRouter.register('DELETE', '/api/schedules/:id/members/:memberId', ScheduleController.removeMember, true);
apiRouter.register('POST', '/api/schedules/:id/attendance', ScheduleController.respondAttendance, true);
apiRouter.register('POST', '/api/schedules/:id/notify', ScheduleController.notifyTeam, true);

// Swaps & Leader Approval Routes
apiRouter.register('GET', '/api/swaps', SwapController.list, true);
apiRouter.register('POST', '/api/swaps', SwapController.create, true);
apiRouter.register('POST', '/api/swaps/batch-approve', SwapController.batchSmartApprove, true);
apiRouter.register('POST', '/api/swaps/:id/confirm-leader', SwapController.confirmWithLeader, true);
apiRouter.register('POST', '/api/swaps/:id/cancel', SwapController.cancel, true);
apiRouter.register('POST', '/api/swaps/:id/resolve', SwapController.resolve, true);
apiRouter.register('POST', '/api/swaps/:id/alert', SwapController.dispatchAlert, true);

// Polls Routes
apiRouter.register('GET', '/api/polls', PollController.list, true);
apiRouter.register('POST', '/api/polls', PollController.create, true);

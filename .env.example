# ============================================================================
# LOUVORAPP - CONFIGURAÇÃO DE AMBIENTE (.env)
# Copie este arquivo para .env na raiz do projeto e ajuste para sua VPS
# ============================================================================

# Ambiente de execução (development | production)
NODE_ENV=production

# Porta de execução do servidor HTTP (usada pelo proxy reverso Nginx)
PORT=3000
HOST=0.0.0.0

# Segredo criptográfico para assinatura de sessões e tokens (altere em produção)
SESSION_SECRET=louvorapp-super-secret-production-key-2025-change-me
SESSION_TTL_HOURS=168

# Caminho do banco de dados SQLite persistente
DB_PATH=./database/louvorapp.sqlite

# Lista de e-mails autorizados a receberem automaticamente o perfil ADMIN no cadastro
# Separados por vírgula. Também pode ser gerenciada nas configurações protegidas.
ADMIN_EMAILS=admin1@email.com,admin2@email.com,lucas@igreja.org,admin@louvorapp.org

# Domínio público para geração de links e CORS na VPS
APP_URL=https://louvor.suaigreja.org
CORS_ORIGIN=*
